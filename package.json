{
  "name": "pytorch-atlas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc -b",
    "build": "tsc -b && vite build && node scripts/package.mjs",
    "test": "node scripts/test-content.mjs",
    "snippets:sync": "node scripts/test-content.mjs --mirror-only",
    "test:e2e": "playwright test",
    "smoke:annotated": "node scripts/smoke-annotated.mjs",
    "projects:sync": "node scripts/generate-project-scripts.mjs",
    "check:coverage": "node scripts/check-coverage.mjs",
    "audit:pdf": "node scripts/audit-pdf.mjs",
    "verify:dist": "node scripts/verify-dist.mjs"
  },
  "dependencies": {
    "prismjs": "^1.30.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/prismjs": "^1.26.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "esbuild": "^0.28.2",
    "pdfjs-dist": "^6.2.108",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-singlefile": "^2.3.0"
  }
}
