  "corrections": [
    {
      "pages": "PDF pp. 8–9, 12–14",
      "issue": "Manual classifier export contains shape-mismatch repair notes.",
      "correction": "Examples align binary logits and targets explicitly and prefer BCEWithLogitsLoss."
    },
    {
      "pages": "PDF pp. 17–18",
      "issue": "Sequential and summary output is terse.",
      "correction": "The reader explains Sequential versus explicit forward and labels optional inspection tooling."
    },
    {
      "pages": "PDF pp. 28, 35–36",
      "issue": "DataLoader details and an exported dataset source are incomplete or broken.",
      "correction": "Sampling, collation, worker behavior and a synthetic offline fallback are documented without embedding a URL."
    },
    {
      "pages": "PDF pp. 89–121",
      "issue": "Some convolution code and totals omit context or parameters.",
      "correction": "Reconstructed runnable shapes and parameter counts include BatchNorm affine values and stated padding assumptions."
    },
    {
      "pages": "PDF pp. 121–141",
      "issue": "Image preprocessing exports contain clipped paths and ambiguous scaling.",
      "correction": "The reader separates image conversion from transforms and avoids scaling uint8 twice."
    },
    {
      "pages": "PDF pp. 148–167",
      "issue": "Recurrent examples mix framework conventions and simplify gradient behavior.",
      "correction": "PyTorch shapes/biases are distinguished; gradient products and clipping limits are qualified."
    },
    {
      "pages": "PDF pp. 168–179",
      "issue": "FAQ code is clipped and predicts a single answer token despite a question-answer framing.",
      "correction": "A complete toy classifier maps finite answer classes to stored responses and makes no general QA claim."
    },
    {
      "pages": "PDF pp. 188–198",
      "issue": "Ideal LSTM gate values are presented as a broad memory guarantee.",
      "correction": "Exact endpoints are identified as idealized; the direct forget route is distinguished from the full Jacobian."
    },
    {
      "pages": "PDF pp. 200–211",
      "issue": "Next-word export requests NLTK downloads, conflates zero padding with UNK, and truncates code lines.",
      "correction": "The runnable CPU project reconstructs the code, uses an offline tokenizer and separate PAD/UNK/EOS IDs, and saves mappings with weights."
    }
  ]
